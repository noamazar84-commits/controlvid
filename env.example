import React, { useState, useEffect, useRef } from "react";
import { Music, Play, Pause, Volume2, Search, Upload, RefreshCw, Check, Sparkles, X, Cloud, HardDrive, ShieldCheck, Tag } from "lucide-react";
import { MusicGenreDropdown } from "./MusicGenreDropdown";

export interface MusicTrack {
  id: string;
  title: string;
  genre: string;
  mood: string;
  duration: string;
  bpm: number;
  url: string;
  s3Key?: string;
  isS3Asset: boolean;
  coverColor?: string;
}

interface S3MusicLibraryModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSelectTrack: (trackName: string, trackUrl: string) => void;
  selectedTrackName?: string;
  niche?: string;
}

export const S3MusicLibraryModal: React.FC<S3MusicLibraryModalProps> = ({
  isOpen,
  onClose,
  onSelectTrack,
  selectedTrackName,
  niche
}) => {
  const [tracks, setTracks] = useState<MusicTrack[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [s3Connected, setS3Connected] = useState<boolean>(false);
  const [bucketName, setBucketName] = useState<string>("");
  const [totalCount, setTotalCount] = useState<number>(0);

  const [searchQuery, setSearchQuery] = useState<string>("");
  const [selectedGenre, setSelectedGenre] = useState<string>("All");
  const [s3OnlyFilter, setS3OnlyFilter] = useState<boolean>(false);

  // Audio Playback
  const [playingTrackId, setPlayingTrackId] = useState<string | null>(null);
  const audioRef = useRef<HTMLAudioElement | null>(null);

  // Upload State
  const [isUploading, setIsUploading] = useState<boolean>(false);
  const [uploadStatus, setUploadStatus] = useState<string>("");
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  useEffect(() => {
    if (isOpen) {
      fetchMusicLibrary();
    } else {
      stopAudio();
    }
  }, [isOpen]);

  const fetchMusicLibrary = async () => {
    setLoading(true);
    try {
      const res = await fetch("/api/music/library");
      const data = await res.json();
      if (data.success) {
        setTracks(data.tracks || []);
        setS3Connected(!!data.s3Connected);
        setBucketName(data.bucketName || "");
        setTotalCount(data.totalCount || data.tracks?.length || 0);
      }
    } catch (err) {
      console.error("[S3 Music Library Modal] Error fetching tracks:", err);
    } finally {
      setLoading(false);
    }
  };

  const stopAudio = () => {
    if (audioRef.current) {
      audioRef.current.pause();
      audioRef.current.currentTime = 0;
    }
    setPlayingTrackId(null);
  };

  const handleTogglePlay = (track: MusicTrack) => {
    if (playingTrackId === track.id) {
      stopAudio();
    } else {
      if (audioRef.current) {
        audioRef.current.pause();
      }
      const newAudio = new Audio(track.url);
      audioRef.current = newAudio;
      newAudio.play().catch(e => console.warn("Audio autoplay blocked or failed:", e));
      setPlayingTrackId(track.id);

      newAudio.onended = () => {
        setPlayingTrackId(null);
      };
    }
  };

  const handleSelectTrack = (track: MusicTrack) => {
    stopAudio();
    onSelectTrack(track.title, track.url);
    onClose();
  };

  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsUploading(true);
    setUploadStatus("Reading audio track...");

    try {
      const reader = new FileReader();
      reader.onload = async () => {
        const base64Data = reader.result as string;
        setUploadStatus("Uploading to S3 Bucket...");

        const response = await fetch("/api/s3/upload", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            filename: file.name,
            base64Data,
            keyPrefix: "music/",
            contentType: file.type || "audio/mpeg"
          })
        });

        const result = await response.json();
        if (result.success) {
          setUploadStatus("Upload complete! Refreshing S3 library...");
          await fetchMusicLibrary();
        } else {
          setUploadStatus(`Upload failed: ${result.error}`);
        }
      };
      reader.readAsDataURL(file);
    } catch (err: any) {
      setUploadStatus(`Error: ${err.message}`);
    } finally {
      setIsUploading(false);
    }
  };

  if (!isOpen) return null;

  // Extraction of unique genres for filter chips
  const allGenres = ["All", ...Array.from(new Set(tracks.map(t => t.genre.replace(/^S3 \/ /, ""))))];

  const filteredTracks = tracks.filter(t => {
    const matchesSearch = 
      t.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
      t.genre.toLowerCase().includes(searchQuery.toLowerCase()) ||
      t.mood.toLowerCase().includes(searchQuery.toLowerCase());
    
    const matchesGenre = selectedGenre === "All" || t.genre.includes(selectedGenre);
    const matchesS3 = !s3OnlyFilter || t.isS3Asset;

    return matchesSearch && matchesGenre && matchesS3;
  });

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 animate-in fade-in duration-200">
      <div className="relative w-full max-w-4xl h-[90vh] bg-[#0c0d14] border border-cyan-500/30 rounded-2xl shadow-[0_0_50px_rgba(56,189,248,0.15)] flex flex-col overflow-hidden text-white font-sans">
        
        {/* Header */}
        <div className="px-6 py-4 border-b border-white/10 flex items-center justify-between bg-slate-950/80">
          <div className="flex items-center gap-3">
            <div className="p-2.5 bg-cyan-500/10 border border-cyan-400/30 rounded-xl text-cyan-400">
              <Music className="w-5 h-5 animate-pulse" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-lg font-black tracking-tight text-white uppercase">S3 Background Music Library</h2>
                <span className="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-400/40">
                  {totalCount}+ Tracks
                </span>
              </div>
              <p className="text-xs text-slate-400 flex items-center gap-2 mt-0.5">
                <span>Select high-retention soundtracks for viral video rendering</span>
                {s3Connected ? (
                  <span className="inline-flex items-center gap-1 text-[10px] font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded">
                    <Cloud className="w-3 h-3" /> S3 Active: {bucketName}
                  </span>
                ) : (
                  <span className="inline-flex items-center gap-1 text-[10px] font-mono text-amber-400 bg-amber-950/60 border border-amber-500/30 px-2 py-0.5 rounded">
                    <HardDrive className="w-3 h-3" /> Standard Catalog (S3 Unconfigured)
                  </span>
                )}
              </p>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={() => fileInputRef.current?.click()}
              disabled={isUploading}
              className="px-3.5 py-1.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-bold uppercase tracking-wider rounded-lg transition-all flex items-center gap-1.5 shadow-lg shadow-cyan-500/20 cursor-pointer disabled:opacity-50"
            >
              <Upload className="w-3.5 h-3.5" />
              <span>Upload Track</span>
            </button>
            <input
              type="file"
              ref={fileInputRef}
              onChange={handleFileUpload}
              accept="audio/*"
              className="hidden"
            />

            <button
              onClick={fetchMusicLibrary}
              title="Refresh Library"
              className="p-2 text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg transition-all border border-white/10"
            >
              <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin' : ''}`} />
            </button>

            <button
              onClick={() => { stopAudio(); onClose(); }}
              className="p-2 text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg transition-all border border-white/10 ml-2"
            >
              <X className="w-5 h-5" />
            </button>
          </div>
        </div>

        {/* Upload Status Alert if active */}
        {uploadStatus && (
          <div className="bg-cyan-950/90 border-b border-cyan-500/30 px-6 py-2 text-xs text-cyan-200 flex items-center justify-between font-mono">
            <span>⚡ {uploadStatus}</span>
            <button onClick={() => setUploadStatus("")} className="text-cyan-400 hover:text-white">Dismiss</button>
          </div>
        )}

        {/* Search & Genre Filters */}
        <div className="p-4 bg-slate-900/40 border-b border-white/10 flex flex-col gap-3">
          <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div className="relative flex-1">
              <Search className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
              <input
                type="text"
                placeholder="Search by track name, genre, or mood (e.g., 'Phonk', 'Cyberpunk', 'Lo-Fi')..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full bg-slate-950 border border-white/10 focus:border-cyan-400/60 rounded-xl pl-10 pr-4 py-2 text-xs text-white placeholder-slate-500 focus:outline-none transition-all"
              />
            </div>

            <div className="w-full sm:w-48">
              <MusicGenreDropdown
                value={selectedGenre}
                onChange={(genre) => setSelectedGenre(genre)}
                options={allGenres}
                placeholder="Filter Genre"
                niche={niche}
                buttonHeight="36px"
              />
            </div>

            <button
              onClick={() => setS3OnlyFilter(!s3OnlyFilter)}
              className={`px-3 py-2 text-xs font-mono font-bold rounded-xl border transition-all flex items-center justify-center gap-1.5 shrink-0 ${
                s3OnlyFilter 
                  ? 'bg-emerald-500/20 border-emerald-400/60 text-emerald-300' 
                  : 'bg-slate-950 border-white/10 text-slate-400 hover:text-white'
              }`}
            >
              <Cloud className="w-3.5 h-3.5" />
              <span>S3 Bucket Assets Only</span>
            </button>
          </div>

          {/* Genre Scroll Chips */}
          <div className="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
            <span className="text-[10px] font-mono text-slate-500 uppercase tracking-wider whitespace-nowrap">Genre:</span>
            {allGenres.map((genre) => (
              <button
                key={genre}
                onClick={() => setSelectedGenre(genre)}
                className={`px-2.5 py-1 text-[11px] font-medium rounded-lg whitespace-nowrap transition-all border ${
                  selectedGenre === genre
                    ? 'bg-cyan-500/20 text-cyan-300 border-cyan-400/50'
                    : 'bg-white/5 text-slate-400 border-white/5 hover:bg-white/10 hover:text-slate-200'
                }`}
              >
                {genre}
              </button>
            ))}
          </div>
        </div>

        {/* Music Track List Grid */}
        <div className="flex-1 overflow-y-auto p-4 space-y-2">
          {loading ? (
            <div className="h-64 flex flex-col items-center justify-center text-slate-400 gap-3">
              <RefreshCw className="w-8 h-8 animate-spin text-cyan-400" />
              <p className="text-xs font-mono">Loading 100+ Background Audio Tracks from S3 Bucket...</p>
            </div>
          ) : filteredTracks.length === 0 ? (
            <div className="h-64 flex flex-col items-center justify-center text-slate-500 gap-2">
              <Music className="w-10 h-10 stroke-1 opacity-40" />
              <p className="text-sm font-medium">No background tracks found matching your query.</p>
              <button onClick={() => { setSearchQuery(""); setSelectedGenre("All"); setS3OnlyFilter(false); }} className="text-xs text-cyan-400 underline">Reset Filters</button>
            </div>
          ) : (
            filteredTracks.map((track) => {
              const isSelected = selectedTrackName === track.title;
              const isPlaying = playingTrackId === track.id;

              return (
                <div
                  key={track.id}
                  className={`group relative p-3 rounded-xl border transition-all flex items-center justify-between ${
                    isSelected
                      ? 'bg-cyan-950/40 border-cyan-400/60 shadow-[0_0_15px_rgba(56,189,248,0.1)]'
                      : 'bg-slate-900/30 border-white/5 hover:border-white/20 hover:bg-slate-900/60'
                  }`}
                >
                  <div className="flex items-center gap-3 flex-1 min-w-0 pr-4">
                    {/* Cover Art / Play Button */}
                    <button
                      onClick={() => handleTogglePlay(track)}
                      className="relative w-10 h-10 rounded-lg flex items-center justify-center shrink-0 transition-transform active:scale-95 cursor-pointer overflow-hidden group"
                      style={{ backgroundColor: track.coverColor || '#1e293b' }}
                    >
                      <div className="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-all" />
                      {isPlaying ? (
                        <div className="relative z-10 flex items-center gap-0.5">
                          <span className="w-1 h-4 bg-cyan-400 animate-bounce" style={{ animationDelay: '0ms' }} />
                          <span className="w-1 h-4 bg-cyan-400 animate-bounce" style={{ animationDelay: '150ms' }} />
                          <span className="w-1 h-4 bg-cyan-400 animate-bounce" style={{ animationDelay: '300ms' }} />
                        </div>
                      ) : (
                        <Play className="w-4 h-4 text-white fill-white relative z-10 ml-0.5 group-hover:scale-110 transition-transform" />
                      )}
                    </button>

                    {/* Track Info */}
                    <div className="min-w-0 flex-1">
                      <div className="flex items-center gap-2">
                        <h4 className="text-xs font-bold text-white truncate">{track.title}</h4>
                        {track.isS3Asset && (
                          <span className="text-[9px] font-mono px-1.5 py-0.2 bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 rounded flex items-center gap-0.5 shrink-0">
                            <Cloud className="w-2.5 h-2.5" /> S3
                          </span>
                        )}
                        {isSelected && (
                          <span className="text-[9px] font-mono px-1.5 py-0.2 bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 rounded shrink-0">
                            Selected
                          </span>
                        )}
                      </div>
                      <div className="flex items-center gap-3 text-[11px] text-slate-400 mt-0.5">
                        <span className="truncate">{track.genre}</span>
                        <span className="text-slate-600">•</span>
                        <span className="truncate text-slate-500">{track.mood}</span>
                      </div>
                    </div>
                  </div>

                  {/* Metadata & Actions */}
                  <div className="flex items-center gap-4 shrink-0">
                    <div className="hidden sm:flex flex-col items-end text-[10px] font-mono text-slate-400">
                      <span>{track.duration}</span>
                      <span className="text-slate-500">{track.bpm} BPM</span>
                    </div>

                    <button
                      onClick={() => handleSelectTrack(track)}
                      className={`px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded-lg transition-all flex items-center gap-1 cursor-pointer ${
                        isSelected
                          ? 'bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/20'
                          : 'bg-white/10 text-white hover:bg-cyan-500/20 hover:text-cyan-300 hover:border-cyan-400/40 border border-transparent'
                      }`}
                    >
                      {isSelected ? <Check className="w-3.5 h-3.5" /> : <Sparkles className="w-3.5 h-3.5" />}
                      <span>{isSelected ? 'Active' : 'Select'}</span>
                    </button>
                  </div>
                </div>
              );
            })
          )}
        </div>

        {/* Footer info bar */}
        <div className="px-6 py-3 bg-slate-950 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
          <div className="flex items-center gap-2 text-[11px]">
            <ShieldCheck className="w-4 h-4 text-cyan-400" />
            <span>All tracks royalty-free for commercial short-form monetization</span>
          </div>
          <button
            onClick={() => { stopAudio(); onClose(); }}
            className="px-4 py-1.5 bg-white/10 hover:bg-white/20 text-white text-xs font-bold rounded-lg transition-all"
          >
            Close
          </button>
        </div>

      </div>
    </div>
  );
};
