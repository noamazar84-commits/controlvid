{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account",
      "type": "object",
      "properties": {
        "serialId": { "type": "integer" },
        "email": { "type": "string" },
        "whop_customer_id": { "type": "string" },
        "subscription_tier": { "type": "string" },
        "credit_balance": { "type": "number" },
        "created_at": { "type": "string" }
      }
    },
    "Financial": {
      "title": "Financial",
      "description": "User financials record",
      "type": "object",
      "properties": {
        "user_id": { "type": "integer" },
        "user_email": { "type": "string" },
        "total_revenue": { "type": "number" },
        "total_api_cost": { "type": "number" },
        "net_profit": { "type": "number" }
      }
    },
    "UsageLog": {
      "title": "UsageLog",
      "description": "Usage activity log",
      "type": "object",
      "properties": {
        "serialId": { "type": "integer" },
        "user_id": { "type": "integer" },
        "user_email": { "type": "string" },
        "action_type": { "type": "string" },
        "cost": { "type": "number" },
        "created_at": { "type": "string" }
      }
    },
    "DMAutomationRule": {
      "title": "DMAutomationRule",
      "description": "DM Automation comment triggers and replies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_email": { "type": "string" },
        "keyword": { "type": "string" },
        "replyMessage": { "type": "string" },
        "enabled": { "type": "boolean" },
        "triggerCount": { "type": "integer" },
        "createdAt": { "type": "string" }
      }
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User support tickets and inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "chatbotReply": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "EnterpriseRequest": {
      "title": "EnterpriseRequest",
      "description": "Enterprise-tier custom requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "email": { "type": "string" },
        "targetVolume": { "type": "integer" },
        "customRequirements": { "type": "string" },
        "estimatedValue": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "SaaS Platform users"
    },
    "/financials/{finId}": {
      "schema": "#/entities/Financial",
      "description": "SaaS Platform financials"
    },
    "/usage_logs/{logId}": {
      "schema": "#/entities/UsageLog",
      "description": "SaaS Platform usage logs"
    },
    "/dm_automation/{ruleId}": {
      "schema": "#/entities/DMAutomationRule",
      "description": "User-configured DM automation triggers"
    },
    "/support_tickets/{ticketId}": {
      "schema": "#/entities/SupportTicket",
      "description": "Submitted support tickets"
    },
    "/enterprise_requests/{requestId}": {
      "schema": "#/entities/EnterpriseRequest",
      "description": "SaaS custom Enterprise requests"
    }
  }
}
